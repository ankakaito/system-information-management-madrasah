<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sim_student_list" model="ir.ui.view">
        <field name="name">sim.student.list</field>
        <field name="model">sim.student</field>
        <field name="arch" type="xml">
            <list string="Data Siswa">
                <field name="nis"/>
                <field name="nisn"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="admission_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sim_student_form" model="ir.ui.view">
        <field name="name">sim.student.form</field>
        <field name="model">sim.student</field>
        <field name="arch" type="xml">
            <form string="Data Siswa">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="applicant,active,graduated,transferred"/>
                <button name="action_set_applicant"
                        type="object"
                        string="Jadikan Calon Siswa"
                        invisible="state == 'applicant'"/>

                <button name="action_set_active"
                        type="object"
                        string="Aktifkan Siswa"
                        invisible="state == 'active'"/>

                <button name="action_set_graduated"
                        type="object"
                        string="Tandai Lulus"
                        invisible="state == 'graduated'"/>

                <button name="action_set_transferred"
                        type="object"
                        string="Tandai Pindah"
                        invisible="state == 'transferred'"/>
                </header>

                <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <field name="image_1920"
                               widget="image"
                               class="oe_avatar"
                               options="{'size': [600, 660]}"/>

                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"
                                       placeholder="Nama lengkap siswa"/>
                            </h1>
                        </div>
                    <!--  <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nama lengkap siswa"/>
                        </h1>
                    </div> -->


                    <group>
                        <group string="Identitas Siswa">
                            <field name="nis"/>
                            <field name="nisn"/>
                            <field name="nik"/>
                            <field name="gender"/>
                            <field name="religion"/>
                        </group>
                        <group string="Informasi Kelahiran">
                            <field name="birth_place"/>
                            <field name="birth_date"/>
                            <field name="admission_date"/>
                        </group>
                    </group>

                    <group string="Kontak">
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>

                    <notebook>
                        <page string="Orang Tua / Wali">
                            <field name="guardian_link_ids">
                                <list editable="bottom">
                                    <field name="guardian_id"
                                           context="{'default_name': ''}"/>
                                    <field name="relationship"/>
                                    <field name="is_primary"/>
                                    <field name="is_emergency_contact"/>
                                    <field name="lives_with_student"/>
                                </list>
                            </field>
                        </page>

                        <page string="Riwayat Pendidikan">
                            <field name="education_history_ids">
                                <list editable="bottom">
                                    <field name="school_name"/>
                                    <field name="education_level"/>
                                    <field name="graduation_year"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page string="Catatan">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sim_student" model="ir.actions.act_window">
        <field name="name">Data Siswa</field>
        <field name="res_model">sim.student</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

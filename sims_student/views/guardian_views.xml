<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sim_student_guardian_list" model="ir.ui.view">
        <field name="name">sim.student.guardian.list</field>
        <field name="model">sim.student.guardian</field>
        <field name="arch" type="xml">
            <list string="Data Wali">
                <field name="name"/>
                <field name="nik"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="occupation"/>
            </list>
        </field>
    </record>

    <record id="view_sim_student_guardian_form" model="ir.ui.view">
        <field name="name">sim.student.guardian.form</field>
        <field name="model">sim.student.guardian</field>
        <field name="arch" type="xml">
            <form string="Data Wali">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="nik"/>
                            <field name="occupation"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group string="Alamat">
                        <field name="address"/>
                    </group>
                    <group string="Siswa Terkait">
                        <field name="student_link_ids">
                            <list>
                                <field name="student_id"/>
                                <field name="relationship"/>
                                <field name="is_primary"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sim_student_guardian"
            model="ir.actions.act_window">
        <field name="name">Data Wali</field>
        <field name="res_model">sim.student.guardian</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<odoo>

    <!-- LIST VIEW -->
    <record id="view_sims_academic_year_list" model="ir.ui.view">
        <field name="name">sims.academic.year.list</field>
        <field name="model">sims.academic.year</field>
        <field name="arch" type="xml">
            <list string="Tahun Ajaran">
                <field name="code"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="semester_count"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_sims_academic_year_form" model="ir.ui.view">
        <field name="name">sims.academic.year.form</field>
        <field name="model">sims.academic.year</field>
        <field name="arch" type="xml">
            <form string="Tahun Ajaran">

                <header>
                    <button name="action_set_draft"
                            type="object"
                            string="Set Draft"
                            invisible="state == 'draft'"/>

                    <button name="action_set_active"
                            type="object"
                            string="Aktifkan"
                            class="oe_highlight"
                            invisible="state == 'active'"/>

                    <button name="action_close"
                            type="object"
                            string="Tutup"
                            invisible="state == 'closed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Contoh: 2027/2028"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Tahun Ajaran">
                            <field name="code"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>

                        <group string="Informasi Tambahan">
                            <field name="semester_count"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Semester">
                            <field name="semester_ids"
                                   readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="sequence"
                                           widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_sims_academic_year" model="ir.actions.act_window">
        <field name="name">Tahun Ajaran</field>
        <field name="res_model">sims.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sims_academic_year_list"/>
    </record>

</odoo>


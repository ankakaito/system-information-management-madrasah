<odoo>

    <!-- LIST VIEW -->
    <record id="view_sims_academic_semester_list" model="ir.ui.view">
        <field name="name">sims.academic.semester.list</field>
        <field name="model">sims.academic.semester</field>
        <field name="arch" type="xml">
            <list string="Semester">
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_sims_academic_semester_form" model="ir.ui.view">
        <field name="name">sims.academic.semester.form</field>
        <field name="model">sims.academic.semester</field>
        <field name="arch" type="xml">
            <form string="Semester">

                <header>
                    <button name="action_set_draft"
                            type="object"
                            string="Set Draft"
                            invisible="state == 'draft'"/>

                    <button name="action_set_active"
                            type="object"
                            string="Aktifkan"
                            class="oe_highlight"
                            invisible="state == 'active'"/>

                    <button name="action_close"
                            type="object"
                            string="Tutup"
                            invisible="state == 'closed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Contoh: Semester Ganjil"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Semester">
                            <field name="academic_year_id"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>

                        <group string="Periode Semester">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_sims_academic_semester"
            model="ir.actions.act_window">
        <field name="name">Semester</field>
        <field name="res_model">sims.academic.semester</field>
        <field name="view_mode">list,form</field>
        <field name="view_id"
               ref="view_sims_academic_semester_list"/>
    </record>

</odoo>


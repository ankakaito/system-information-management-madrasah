<odoo>
    <data noupdate="1">

        <!-- Sequence Jenis Dokumen -->
        <record id="seq_sims_ppdb_document_type" model="ir.sequence">
            <field name="name">Kode Jenis Dokumen PPDB</field>
            <field name="code">sims.ppdb.document.type</field>
            <field name="prefix">DK</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence Komponen Seleksi -->
        <record id="seq_sims_ppdb_selection_component" model="ir.sequence">
            <field name="name">Kode Komponen Seleksi PPDB</field>
            <field name="code">sims.ppdb.selection.component</field>
            <field name="prefix">KS</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence Jalur Pendaftaran -->
        <record id="seq_sims_ppdb_registration_path" model="ir.sequence">
            <field name="name">Kode Jalur Pendaftaran PPDB</field>
            <field name="code">sims.ppdb.registration.path</field>
            <field name="prefix">PB</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence Jenis Prestasi -->
        <record id="seq_sims_ppdb_achievement_type" model="ir.sequence">
            <field name="name">Kode Jenis Prestasi</field>
            <field name="code">sims.ppdb.achievement.type</field>
            <field name="prefix">JP</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence Periode PPDB -->
        <record id="seq_sims_ppdb_period" model="ir.sequence">
            <field name="name">Kode Periode PPDB</field>
            <field name="code">sims.ppdb.period</field>
            <field name="prefix">PR</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence Gelombang PPDB -->
        <record id="seq_sims_ppdb_wave" model="ir.sequence">
            <field name="name">Gelombang Pendaftaran PPDB</field>
            <field name="code">sims.ppdb.wave</field>
            <field name="prefix">GLB</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>

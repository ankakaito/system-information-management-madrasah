<odoo>
    <record id="view_sims_ppdb_document_requirement_list" model="ir.ui.view">
        <field name="name">sims.ppdb.document.requirement.list</field>
        <field name="model">sims.ppdb.document.requirement</field>
        <field name="arch" type="xml">
            <list string="Persyaratan Dokumen PPDB">
                <field name="sequence" widget="handle"/>
                <field name="period_id"/>
                <field name="document_type_id"/>
                <field name="is_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sims_ppdb_document_requirement_form" model="ir.ui.view">
        <field name="name">sims.ppdb.document.requirement.form</field>
        <field name="model">sims.ppdb.document.requirement</field>
        <field name="arch" type="xml">
            <form string="Persyaratan Dokumen PPDB">
                <sheet>
                    <div class="oe_title">
                        <h1>Persyaratan Dokumen PPDB</h1>
                    </div>

                    <group>
                        <group>
                            <field name="period_id"/>
                            <field name="document_type_id"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Keterangan">
                        <field name="description"
                               placeholder="Contoh: Dokumen harus jelas dan dapat dibaca."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sims_ppdb_document_requirement" model="ir.actions.act_window">
        <field name="name">Persyaratan Dokumen</field>
        <field name="res_model">sims.ppdb.document.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_sims_ppdb_wave_path_selection_list"
            model="ir.ui.view">

        <field name="name">
            sims.ppdb.wave.path.selection.list
        </field>

        <field name="model">
            sims.ppdb.wave.path.selection
        </field>

        <field name="arch" type="xml">
            <list string="Komponen Seleksi per Jalur">
                <field name="sequence" widget="handle"/>
                <field name="wave_path_id"/>
                <field name="selection_component_id"/>
                <field name="max_score"/>
                <field name="min_score"/>
                <field name="weight"/>
                <field name="is_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_sims_ppdb_wave_path_selection_form"
            model="ir.ui.view">

        <field name="name">
            sims.ppdb.wave.path.selection.form
        </field>

        <field name="model">
            sims.ppdb.wave.path.selection
        </field>

        <field name="arch" type="xml">
            <form string="Komponen Seleksi per Jalur">
                <sheet>

                    <div class="oe_title">
                        <label for="selection_component_id"/>
                        <h1>
                            <field name="selection_component_id"
                                   placeholder="Pilih Komponen Seleksi"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Seleksi">
                            <field name="wave_path_id"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="is_required"/>
                            <field name="active"/>
                        </group>

                        <group string="Pengaturan Penilaian">
                            <field name="max_score"/>
                            <field name="min_score"/>
                            <field name="weight"/>
                        </group>
                    </group>

                    <group string="Keterangan">
                        <field name="description"
                               placeholder="Keterangan atau petunjuk pelaksanaan seleksi..."/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Window Action -->
    <record id="action_sims_ppdb_wave_path_selection"
            model="ir.actions.act_window">

        <field name="name">Komponen Seleksi per Jalur</field>
        <field name="res_model">
            sims.ppdb.wave.path.selection
        </field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>

    </record>

</odoo>

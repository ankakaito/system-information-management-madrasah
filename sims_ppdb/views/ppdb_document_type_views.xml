
<odoo>

    <record id="view_sims_ppdb_document_type_list" model="ir.ui.view">
        <field name="name">sims.ppdb.document.type.list</field>
        <field name="model">sims.ppdb.document.type</field>
        <field name="arch" type="xml">
            <list string="Jenis Dokumen">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_required_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sims_ppdb_document_type_form" model="ir.ui.view">
        <field name="name">sims.ppdb.document.type.form</field>
        <field name="model">sims.ppdb.document.type</field>
        <field name="arch" type="xml">
            <form string="Jenis Dokumen">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="Contoh: Kartu Keluarga"
                            />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>

                        <group>
                            <field name="is_required_default"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sims_ppdb_document_type" model="ir.actions.act_window">
        <field name="name">Jenis Dokumen</field>
        <field name="res_model">sims.ppdb.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>


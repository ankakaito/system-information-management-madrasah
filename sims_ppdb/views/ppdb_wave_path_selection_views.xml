<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View Konfigurasi Seleksi -->
    <record id="view_sims_ppdb_wave_path_selection_list" model="ir.ui.view">
        <field name="name">sims.ppdb.wave.path.selection.list</field>
        <field name="model">sims.ppdb.wave.path.selection</field>
        <field name="arch" type="xml">
            <list string="Konfigurasi Komponen Seleksi">
                <field name="wave_path_id"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View Konfigurasi Seleksi -->
    <record id="view_sims_ppdb_wave_path_selection_form" model="ir.ui.view">
        <field name="name">sims.ppdb.wave.path.selection.form</field>
        <field name="model">sims.ppdb.wave.path.selection</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi Komponen Seleksi">
                <sheet>

                    <div class="oe_title">
                        <label for="wave_path_id"/>
                        <h1>
                            <field name="wave_path_id"
                                   options="{'no_create': True}"/>
                        </h1>
                    </div>

                    <group>
                        <field name="active"/>
                    </group>
                    <!-- <group>
                        <field name="total_weight" readonly="1"/>
                    </group> -->
                    <notebook>
                        <page string="Komponen Seleksi" name="selection_components">
                            <field name="selection_component_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="selection_component_id" options="{'no_create': True}"/>
                                    <field name="max_score"/>
                                    <field name="min_score"/>
                                    <field name="weight"/>
                                    <field name="is_required"/>
                                    <field name="active" column_invisible="True"/>
                                </list>
                            </field>
                            <div class="d-flex justify-content-end align-items-center gap-3 mt-3 mb-3">
                                <label for="total_weight" string="Total Bobot (%)"/>
                                <field name="total_weight" nolabel="1" readonly="1" class="oe_inline"/>
                            </div>
                        </page>
                        <page string="Keterangan" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_sims_ppdb_wave_path_selection"
            model="ir.actions.act_window">
        <field name="name">Komponen Seleksi per Jalur</field>
        <field name="res_model">sims.ppdb.wave.path.selection</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>

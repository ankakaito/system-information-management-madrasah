<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_sims_ppdb_selection_component_type_list"
            model="ir.ui.view">
        <field name="name">sims.ppdb.selection.component.type.list</field>
        <field name="model">sims.ppdb.selection.component.type</field>
        <field name="arch" type="xml">
            <list string="Jenis Komponen Seleksi">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sims_ppdb_selection_component_type_form"
            model="ir.ui.view">
        <field name="name">sims.ppdb.selection.component.type.form</field>
        <field name="model">sims.ppdb.selection.component.type</field>
        <field name="arch" type="xml">
            <form string="Jenis Komponen Seleksi">
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Contoh: Domisili / Jarak"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Jenis Komponen">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Keterangan">
                        <field name="description"
                               placeholder="Penjelasan jenis komponen..."/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sims_ppdb_selection_component_type"
            model="ir.actions.act_window">
        <field name="name">Jenis Komponen Seleksi</field>
        <field name="res_model">sims.ppdb.selection.component.type</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_sims_ppdb_wave_list" model="ir.ui.view">
        <field name="name">sims.ppdb.wave.list</field>
        <field name="model">sims.ppdb.wave</field>
        <field name="arch" type="xml">
            <list string="Gelombang Pendaftaran">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="period_id"/>
                <field name="date_start" widget="date" options="{'numeric': true}"/>
                <field name="date_end" widget="date" options="{'numeric': true}"/>
                <field name="quota"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sims_ppdb_wave_form" model="ir.ui.view">
        <field name="name">sims.ppdb.wave.form</field>
        <field name="model">sims.ppdb.wave</field>
        <field name="arch" type="xml">
            <form string="Gelombang Pendaftaran">
                <header>
                    <button name="action_open"
                            string="Buka Pendaftaran"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_close"
                            string="Tutup Pendaftaran"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'open'"/>
                    <button name="action_reset_draft"
                            string="Set ke Draft"
                            type="object"
                            invisible="state != 'closed'"/>

                    <button name="action_reset_draft"
                            string="Set ke Draft"
                            type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Contoh: Gelombang 1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Gelombang">
                            <field name="code" readonly="True"/>
                            <field name="period_id"/>
                            <field name="sequence"/>
                        </group>

                        <group string="Jadwal dan Kuota">
                            <field name="date_start" widget="date" options="{'numeric': true}"/>
                            <field name="date_end" widget="date" options="{'numeric': true}"/>
                            <field name="quota"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"
                               placeholder="Keterangan gelombang..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_sims_ppdb_wave" model="ir.actions.act_window">
        <field name="name">Gelombang Pendaftaran</field>
        <field name="res_model">sims.ppdb.wave</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>

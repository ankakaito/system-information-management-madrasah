
<odoo>

    <record id="view_sims_ppdb_selection_component_list" model="ir.ui.view">
        <field name="name">sims.ppdb.selection.component.list</field>
        <field name="model">sims.ppdb.selection.component</field>
        <field name="arch" type="xml">
            <list string="Komponen Seleksi">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="component_type"/>
                <field name="max_score"/>
                <field name="weight"/>
                <field name="is_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sims_ppdb_selection_component_form" model="ir.ui.view">
        <field name="name">sims.ppdb.selection.component.form</field>
        <field name="model">sims.ppdb.selection.component</field>
        <field name="arch" type="xml">
            <form string="Komponen Seleksi">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="Contoh: Tes Akademik"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Komponen">
                            <field name="code"/>
                            <field name="component_type"/>
                            <field name="sequence"/>
                        </group>

                        <group string="Penilaian">
                            <field name="max_score"/>
                            <field name="weight"/>
                            <field name="is_required"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sims_ppdb_selection_component" model="ir.actions.act_window">
        <field name="name">Komponen Seleksi</field>
        <field name="res_model">sims.ppdb.selection.component</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

